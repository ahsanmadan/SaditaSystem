APP_NAME="Sadita System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sadita_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
FILAMENT_SPA_MODE=true

BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sadita.com"
MAIL_FROM_NAME="${APP_NAME}"

GROQ_API_KEY=
GROQ_MODEL=

DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_MERCHANT_NAME="${APP_NAME}"
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_NOTIFICATION_URL="${APP_URL}/payments/doku/notify"
DOKU_RETURN_URL="${APP_URL}/payments/doku/return/{order_id}"
DOKU_DEFAULT_CITY=Padang
DOKU_DEFAULT_POSTAL_CODE=25100
DOKU_DEFAULT_COUNTRY_CODE=IDN

VITE_APP_NAME="${APP_NAME}"
