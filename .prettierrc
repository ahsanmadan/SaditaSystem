{
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": true,
    "plugins": ["prettier-plugin-blade"],
    "overrides": [
        {
            "files": ["*.blade.php"],
            "options": {
                "parser": "blade",
                "tabWidth": 4,
                "sortTailwindcssClasses": true
            }
        }
    ]
}
