<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ToBe"
  name="BPMN To-Be - Proses Pemesanan via SaditaSystem (Web)"
  targetNamespace="http://saditasystem.com/bpmn/tobe"
  exporter="Enterprise Architect"
  exporterVersion="16.0">

  <!--
    ================================================================
    BPMN TO-BE: Proses Pemesanan via Aplikasi Web SaditaSystem
    Kondisi SETELAH implementasi SaditaSystem (Laravel + Database)
    Aktor:
      1. Pelanggan (via Browser / Web)
      2. Sistem SaditaSystem (Automated - Laravel Backend)
      3. Admin Sadita Decoration (via Dashboard Web)
    Alur Kritis (Sesuai Hasil Wawancara Mitra):
      - FULL PAYMENT: Tidak ada sistem DP. Pelanggan bayar lunas saat checkout.
      - NOTIFIKASI: Hanya melalui Email (bukan WhatsApp).
      - STOK: Dikelola admin melalui Dashboard, bukan secara manual.
      - TRACKING: Pelanggan bisa pantau status pesanan via halaman web.
    ================================================================
  -->

  <!-- ============================================================ -->
  <!--  COLLABORATION                                               -->
  <!-- ============================================================ -->
  <collaboration id="Collaboration_ToBe" name="Proses Pemesanan via Aplikasi Web SaditaSystem">
    <participant id="Part_Pelanggan"    name="Pelanggan (Browser Web)"      processRef="Proc_Pelanggan"/>
    <participant id="Part_Sistem"       name="Sistem SaditaSystem (Server)" processRef="Proc_Sistem"/>
    <participant id="Part_Admin"        name="Admin Sadita (Dashboard)"     processRef="Proc_Admin"/>

    <!-- Message Flows: Pelanggan → Sistem -->
    <messageFlow id="MF_T_01" name="Request akses halaman katalog"              sourceRef="Task_P_BukaWeb"              targetRef="Task_S_TampilKatalog"/>
    <messageFlow id="MF_T_02" name="Submit filter produk (kategori/ukuran)"     sourceRef="Task_P_FilterProduk"         targetRef="Task_S_FilterProduk"/>
    <messageFlow id="MF_T_03" name="Submit form checkout (data diri + tanggal)" sourceRef="Task_P_IsiFormCheckout"      targetRef="Task_S_ValidasiForm"/>
    <messageFlow id="MF_T_04" name="Konfirmasi pembayaran (nominal + rekening)"  sourceRef="Task_P_BayarTransfer"        targetRef="Task_S_TerimaNotifBayar"/>
    <messageFlow id="MF_T_05" name="Upload bukti transfer"                       sourceRef="Task_P_UploadBukti"          targetRef="Task_S_SimpanBukti"/>

    <!-- Message Flows: Sistem → Pelanggan -->
    <messageFlow id="MF_T_06" name="Response halaman katalog (HTML)"            sourceRef="Task_S_TampilKatalog"        targetRef="Task_P_BrowseKatalog"/>
    <messageFlow id="MF_T_07" name="Response hasil filter produk"               sourceRef="Task_S_FilterProduk"         targetRef="Task_P_LihatHasilFilter"/>
    <messageFlow id="MF_T_08" name="Response validasi form (error / OK)"        sourceRef="Task_S_ValidasiForm"         targetRef="Task_P_TerimaValidasi"/>
    <messageFlow id="MF_T_09" name="Email konfirmasi pesanan masuk (+ order ID)" sourceRef="Task_S_KirimEmailPelanggan" targetRef="Task_P_TerimaEmailKonfirmasi"/>
    <messageFlow id="MF_T_10" name="Email notifikasi pesanan dikonfirmasi admin" sourceRef="Task_S_KirimEmailStatusOK"  targetRef="Task_P_TerimaEmailStatusOK"/>
    <messageFlow id="MF_T_11" name="Email notifikasi pesanan siap diambil"      sourceRef="Task_S_KirimEmailSiap"       targetRef="Task_P_TerimaEmailSiap"/>

    <!-- Message Flows: Sistem → Admin -->
    <messageFlow id="MF_T_12" name="Email notifikasi pesanan baru masuk (+ detail)" sourceRef="Task_S_KirimEmailAdmin" targetRef="Task_A_TerimaEmailPesanan"/>

    <!-- Message Flows: Admin → Sistem -->
    <messageFlow id="MF_T_13" name="Action: Konfirmasi / Tolak pesanan di dashboard" sourceRef="Task_A_UpdateStatusPesanan" targetRef="Task_S_ProsesStatusUpdate"/>
    <messageFlow id="MF_T_14" name="Action: Tandai pesanan selesai / siap diambil"   sourceRef="Task_A_TandaiSelesai"      targetRef="Task_S_UpdateStatusSelesai"/>
  </collaboration>

  <!-- ============================================================ -->
  <!--  POOL 1: PROSES PELANGGAN                                    -->
  <!-- ============================================================ -->
  <process id="Proc_Pelanggan" name="Proses Pelanggan via Browser Web" isExecutable="false">

    <laneSet id="LS_Pelanggan">
      <lane id="Lane_Pelanggan" name="Pelanggan (Browser Web)">
        <flowNodeRef>Start_P</flowNodeRef>
        <flowNodeRef>Task_P_BukaWeb</flowNodeRef>
        <flowNodeRef>Task_P_BrowseKatalog</flowNodeRef>
        <flowNodeRef>Task_P_FilterProduk</flowNodeRef>
        <flowNodeRef>Task_P_LihatHasilFilter</flowNodeRef>
        <flowNodeRef>Task_P_LihatDetailProduk</flowNodeRef>
        <flowNodeRef>GW_P_Minat</flowNodeRef>
        <flowNodeRef>Task_P_IsiFormCheckout</flowNodeRef>
        <flowNodeRef>Task_P_TerimaValidasi</flowNodeRef>
        <flowNodeRef>GW_P_ValidasiOK</flowNodeRef>
        <flowNodeRef>Task_P_BayarTransfer</flowNodeRef>
        <flowNodeRef>Task_P_UploadBukti</flowNodeRef>
        <flowNodeRef>Task_P_TerimaEmailKonfirmasi</flowNodeRef>
        <flowNodeRef>Task_P_PantauStatusPesanan</flowNodeRef>
        <flowNodeRef>Task_P_TerimaEmailStatusOK</flowNodeRef>
        <flowNodeRef>Task_P_TerimaEmailSiap</flowNodeRef>
        <flowNodeRef>Task_P_AmbilProduk</flowNodeRef>
        <flowNodeRef>End_P_Selesai</flowNodeRef>
        <flowNodeRef>End_P_TidakMinat</flowNodeRef>
        <flowNodeRef>End_P_FormError</flowNodeRef>
      </lane>
    </laneSet>

    <!-- START: Pelanggan buka browser -->
    <startEvent id="Start_P" name="Pelanggan ingin memesan produk dekorasi atau seserahan Sadita">
      <outgoing>SF_P_T_01</outgoing>
    </startEvent>

    <!-- 1. Buka website SaditaSystem -->
    <task id="Task_P_BukaWeb" name="Membuka website SaditaSystem melalui browser (URL: saditasystem.vercel.app)">
      <incoming>SF_P_T_01</incoming>
      <outgoing>SF_P_T_02</outgoing>
    </task>

    <!-- 2. Browse halaman katalog (konten ditampilkan oleh sistem) -->
    <task id="Task_P_BrowseKatalog" name="Melihat-lihat halaman katalog produk Sadita (Papan Ucapan, Hantaran, Box Dekorasi) yang ditampilkan sistem">
      <incoming>SF_P_T_02</incoming>
      <outgoing>SF_P_T_03</outgoing>
    </task>

    <!-- 3. Filter produk berdasarkan kategori / ukuran -->
    <task id="Task_P_FilterProduk" name="Menggunakan fitur filter untuk menyaring produk berdasarkan kategori (jenis) atau variasi (ukuran / material: kaca / akrilik)">
      <incoming>SF_P_T_03</incoming>
      <outgoing>SF_P_T_04</outgoing>
    </task>

    <!-- 4. Lihat hasil filter -->
    <task id="Task_P_LihatHasilFilter" name="Melihat daftar produk yang sesuai dengan filter yang dipilih beserta harga, foto, dan deskripsi material">
      <incoming>SF_P_T_04</incoming>
      <outgoing>SF_P_T_05</outgoing>
    </task>

    <!-- 5. Klik produk untuk lihat detail -->
    <task id="Task_P_LihatDetailProduk" name="Membuka halaman detail produk untuk melihat foto lengkap, spesifikasi ukuran, material yang tersedia, stok, dan harga">
      <incoming>SF_P_T_05</incoming>
      <outgoing>SF_P_T_06</outgoing>
    </task>

    <!-- 6. Gateway: Tertarik pesan? -->
    <exclusiveGateway id="GW_P_Minat" name="Apakah pelanggan tertarik untuk memesan produk ini?">
      <incoming>SF_P_T_06</incoming>
      <outgoing>SF_P_T_07_Ya</outgoing>
      <outgoing>SF_P_T_07_Tidak</outgoing>
    </exclusiveGateway>

    <!-- 7a. Tidak tertarik -->
    <endEvent id="End_P_TidakMinat" name="Pelanggan menutup website, tidak jadi memesan">
      <incoming>SF_P_T_07_Tidak</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 7b. Tertarik: Isi form checkout -->
    <task id="Task_P_IsiFormCheckout" name="Mengisi form checkout: nama lengkap, email aktif, nomor telepon, tanggal acara yang diinginkan, jumlah unit, dan alamat pengiriman (jika ada)">
      <incoming>SF_P_T_07_Ya</incoming>
      <outgoing>SF_P_T_08</outgoing>
    </task>

    <!-- 8. Terima hasil validasi form dari sistem -->
    <task id="Task_P_TerimaValidasi" name="Menerima feedback dari sistem mengenai validasi isian form checkout (field wajib, format email, ketersediaan tanggal)">
      <incoming>SF_P_T_08</incoming>
      <outgoing>SF_P_T_09</outgoing>
    </task>

    <!-- 9. Gateway: Form valid? -->
    <exclusiveGateway id="GW_P_ValidasiOK" name="Apakah semua isian form checkout valid dan tanggal masih tersedia?">
      <incoming>SF_P_T_09</incoming>
      <outgoing>SF_P_T_10_Valid</outgoing>
      <outgoing>SF_P_T_10_Error</outgoing>
    </exclusiveGateway>

    <!-- 10a. Form error: tampilkan pesan error (pelanggan isi ulang) -->
    <endEvent id="End_P_FormError" name="Form checkout ditolak sistem karena data tidak valid atau tanggal sudah dipesan (pelanggan wajib mengisi ulang)">
      <incoming>SF_P_T_10_Error</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 10b. Form valid: lanjut ke instruksi pembayaran -->
    <task id="Task_P_BayarTransfer" name="Melihat instruksi pembayaran LUNAS (Full Payment) yang ditampilkan sistem: nomor rekening admin, nominal yang harus dibayar, dan batas waktu konfirmasi">
      <incoming>SF_P_T_10_Valid</incoming>
      <outgoing>SF_P_T_11</outgoing>
    </task>

    <!-- 11. Upload bukti transfer -->
    <task id="Task_P_UploadBukti" name="Melakukan transfer bank sejumlah total harga, lalu mengupload foto bukti transfer melalui form upload di halaman web">
      <incoming>SF_P_T_11</incoming>
      <outgoing>SF_P_T_12</outgoing>
    </task>

    <!-- 12. Terima email konfirmasi pesanan masuk dari sistem -->
    <task id="Task_P_TerimaEmailKonfirmasi" name="Menerima email otomatis dari sistem berisi: ID Pesanan, detail produk, tanggal acara, total yang dibayar, dan status menunggu verifikasi admin">
      <incoming>SF_P_T_12</incoming>
      <outgoing>SF_P_T_13</outgoing>
    </task>

    <!-- 13. Pantau status pesanan di halaman web -->
    <task id="Task_P_PantauStatusPesanan" name="Memantau status pesanan secara real-time melalui halaman tracking di website SaditaSystem menggunakan nomor Order ID">
      <incoming>SF_P_T_13</incoming>
      <outgoing>SF_P_T_14</outgoing>
    </task>

    <!-- 14. Terima email notifikasi status dikonfirmasi admin -->
    <task id="Task_P_TerimaEmailStatusOK" name="Menerima email otomatis dari sistem yang memberitahu bahwa pembayaran telah diverifikasi dan pesanan resmi dikonfirmasi oleh admin Sadita">
      <incoming>SF_P_T_14</incoming>
      <outgoing>SF_P_T_15</outgoing>
    </task>

    <!-- 15. Terima email notifikasi produk siap diambil -->
    <task id="Task_P_TerimaEmailSiap" name="Menerima email otomatis dari sistem yang memberitahu bahwa produk / dekorasi sudah selesai dipersiapkan dan siap diambil atau diantarkan pada tanggal yang disepakati">
      <incoming>SF_P_T_15</incoming>
      <outgoing>SF_P_T_16</outgoing>
    </task>

    <!-- 16. Ambil produk pada hari H -->
    <task id="Task_P_AmbilProduk" name="Mengambil atau menerima produk dekorasi / seserahan dari Sadita sesuai tanggal acara yang disepakati pada saat checkout">
      <incoming>SF_P_T_16</incoming>
      <outgoing>SF_P_T_END</outgoing>
    </task>

    <!-- END -->
    <endEvent id="End_P_Selesai" name="Transaksi selesai, pelanggan menerima produk dengan baik">
      <incoming>SF_P_T_END</incoming>
    </endEvent>

    <!-- Sequence Flows: Pelanggan -->
    <sequenceFlow id="SF_P_T_01"        sourceRef="Start_P"                    targetRef="Task_P_BukaWeb"/>
    <sequenceFlow id="SF_P_T_02"        sourceRef="Task_P_BukaWeb"             targetRef="Task_P_BrowseKatalog"/>
    <sequenceFlow id="SF_P_T_03"        sourceRef="Task_P_BrowseKatalog"       targetRef="Task_P_FilterProduk"/>
    <sequenceFlow id="SF_P_T_04"        sourceRef="Task_P_FilterProduk"        targetRef="Task_P_LihatHasilFilter"/>
    <sequenceFlow id="SF_P_T_05"        sourceRef="Task_P_LihatHasilFilter"    targetRef="Task_P_LihatDetailProduk"/>
    <sequenceFlow id="SF_P_T_06"        sourceRef="Task_P_LihatDetailProduk"   targetRef="GW_P_Minat"/>
    <sequenceFlow id="SF_P_T_07_Ya"     name="Ya, ingin pesan"                 sourceRef="GW_P_Minat"                 targetRef="Task_P_IsiFormCheckout"/>
    <sequenceFlow id="SF_P_T_07_Tidak"  name="Tidak tertarik"                  sourceRef="GW_P_Minat"                 targetRef="End_P_TidakMinat"/>
    <sequenceFlow id="SF_P_T_08"        sourceRef="Task_P_IsiFormCheckout"     targetRef="Task_P_TerimaValidasi"/>
    <sequenceFlow id="SF_P_T_09"        sourceRef="Task_P_TerimaValidasi"      targetRef="GW_P_ValidasiOK"/>
    <sequenceFlow id="SF_P_T_10_Valid"  name="Data valid, tanggal tersedia"    sourceRef="GW_P_ValidasiOK"            targetRef="Task_P_BayarTransfer"/>
    <sequenceFlow id="SF_P_T_10_Error"  name="Data tidak valid / tanggal penuh" sourceRef="GW_P_ValidasiOK"           targetRef="End_P_FormError"/>
    <sequenceFlow id="SF_P_T_11"        sourceRef="Task_P_BayarTransfer"       targetRef="Task_P_UploadBukti"/>
    <sequenceFlow id="SF_P_T_12"        sourceRef="Task_P_UploadBukti"         targetRef="Task_P_TerimaEmailKonfirmasi"/>
    <sequenceFlow id="SF_P_T_13"        sourceRef="Task_P_TerimaEmailKonfirmasi" targetRef="Task_P_PantauStatusPesanan"/>
    <sequenceFlow id="SF_P_T_14"        sourceRef="Task_P_PantauStatusPesanan" targetRef="Task_P_TerimaEmailStatusOK"/>
    <sequenceFlow id="SF_P_T_15"        sourceRef="Task_P_TerimaEmailStatusOK" targetRef="Task_P_TerimaEmailSiap"/>
    <sequenceFlow id="SF_P_T_16"        sourceRef="Task_P_TerimaEmailSiap"     targetRef="Task_P_AmbilProduk"/>
    <sequenceFlow id="SF_P_T_END"       sourceRef="Task_P_AmbilProduk"         targetRef="End_P_Selesai"/>
  </process>

  <!-- ============================================================ -->
  <!--  POOL 2: PROSES SISTEM SADITASYSTEM (BACKEND OTOMATIS)       -->
  <!-- ============================================================ -->
  <process id="Proc_Sistem" name="Proses Sistem SaditaSystem (Otomatis - Laravel Backend)" isExecutable="false">

    <laneSet id="LS_Sistem">
      <lane id="Lane_Sistem" name="Sistem SaditaSystem (Server Laravel)">
        <flowNodeRef>Start_S</flowNodeRef>
        <flowNodeRef>Task_S_TampilKatalog</flowNodeRef>
        <flowNodeRef>Task_S_FilterProduk</flowNodeRef>
        <flowNodeRef>Task_S_ValidasiForm</flowNodeRef>
        <flowNodeRef>GW_S_FormValid</flowNodeRef>
        <flowNodeRef>Task_S_SimpanPesanan</flowNodeRef>
        <flowNodeRef>Task_S_TerimaNotifBayar</flowNodeRef>
        <flowNodeRef>Task_S_SimpanBukti</flowNodeRef>
        <flowNodeRef>Task_S_KirimEmailAdmin</flowNodeRef>
        <flowNodeRef>Task_S_KirimEmailPelanggan</flowNodeRef>
        <flowNodeRef>Task_S_ProsesStatusUpdate</flowNodeRef>
        <flowNodeRef>GW_S_StatusKeputusan</flowNodeRef>
        <flowNodeRef>Task_S_KirimEmailStatusOK</flowNodeRef>
        <flowNodeRef>Task_S_KirimEmailTolak</flowNodeRef>
        <flowNodeRef>Task_S_UpdateStatusSelesai</flowNodeRef>
        <flowNodeRef>Task_S_KirimEmailSiap</flowNodeRef>
        <flowNodeRef>End_S_Selesai</flowNodeRef>
        <flowNodeRef>End_S_FormDitolak</flowNodeRef>
        <flowNodeRef>End_S_PesananDitolak</flowNodeRef>
      </lane>
    </laneSet>

    <!-- START: Sistem menerima request dari browser -->
    <startEvent id="Start_S" name="Sistem menerima HTTP request dari browser pelanggan">
      <outgoing>SF_S_T_01</outgoing>
      <messageEventDefinition messageRef="Msg_RequestKatalog"/>
    </startEvent>

    <!-- 1. Tampilkan halaman katalog dari database -->
    <task id="Task_S_TampilKatalog" name="Mengambil data produk dari database (tabel products + categories) dan merender halaman katalog dengan foto, harga, stok, dan variasi produk">
      <incoming>SF_S_T_01</incoming>
      <outgoing>SF_S_T_02</outgoing>
    </task>

    <!-- 2. Proses query filter produk -->
    <task id="Task_S_FilterProduk" name="Memproses query filter dari pelanggan (berdasarkan category_id, material, size) dan mengembalikan hasil query ke browser pelanggan">
      <incoming>SF_S_T_02</incoming>
      <outgoing>SF_S_T_03</outgoing>
    </task>

    <!-- 3. Validasi form checkout -->
    <task id="Task_S_ValidasiForm" name="Memvalidasi data form checkout: field wajib tidak boleh kosong, format email valid, nomor telepon valid, dan tanggal acara tidak konflik dengan pesanan lain di database">
      <incoming>SF_S_T_03</incoming>
      <outgoing>SF_S_T_04</outgoing>
    </task>

    <!-- 4. Gateway: Form valid? -->
    <exclusiveGateway id="GW_S_FormValid" name="Apakah hasil validasi form checkout valid?">
      <incoming>SF_S_T_04</incoming>
      <outgoing>SF_S_T_05_Valid</outgoing>
      <outgoing>SF_S_T_05_Invalid</outgoing>
    </exclusiveGateway>

    <!-- 5a. Form tidak valid: kirim error response -->
    <endEvent id="End_S_FormDitolak" name="Sistem mengembalikan response error validasi ke browser pelanggan (field wajib kosong / tanggal penuh)">
      <incoming>SF_S_T_05_Invalid</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 5b. Form valid: simpan pesanan ke database -->
    <task id="Task_S_SimpanPesanan" name="Menyimpan data pesanan baru ke database: tabel bookings (status: pending_payment) dan tabel booking_items, lalu membuat Order ID unik untuk tracking">
      <incoming>SF_S_T_05_Valid</incoming>
      <outgoing>SF_S_T_06</outgoing>
    </task>

    <!-- 6. Terima notifikasi pembayaran dari pelanggan -->
    <task id="Task_S_TerimaNotifBayar" name="Menerima data pembayaran yang disubmit pelanggan (nominal, metode: transfer/tunai)">
      <incoming>SF_S_T_06</incoming>
      <outgoing>SF_S_T_07</outgoing>
    </task>

    <!-- 7. Simpan bukti transfer ke server -->
    <task id="Task_S_SimpanBukti" name="Menyimpan file foto bukti transfer yang diupload pelanggan ke storage server dan mengasosiasikannya dengan record booking di database">
      <incoming>SF_S_T_07</incoming>
      <outgoing>SF_S_T_08</outgoing>
    </task>

    <!-- 8a. Kirim email notifikasi ke Admin Sadita -->
    <task id="Task_S_KirimEmailAdmin" name="Mengirim email otomatis ke email Admin Sadita berisi: detail pesanan baru, Order ID, nama pelanggan, produk, tanggal acara, dan link akses dashboard untuk konfirmasi">
      <incoming>SF_S_T_08</incoming>
      <outgoing>SF_S_T_09</outgoing>
    </task>

    <!-- 8b. Kirim email konfirmasi ke Pelanggan -->
    <task id="Task_S_KirimEmailPelanggan" name="Mengirim email otomatis ke email pelanggan berisi: Order ID, ringkasan pesanan, total yang dibayar, status transaksi saat ini (menunggu konfirmasi admin)">
      <incoming>SF_S_T_09</incoming>
      <outgoing>SF_S_T_10</outgoing>
    </task>

    <!-- 9. Proses update status dari aksi admin -->
    <task id="Task_S_ProsesStatusUpdate" name="Menerima dan memproses aksi Admin dari Dashboard: update status pesanan di database (tabel bookings) sesuai keputusan admin">
      <incoming>SF_S_T_10</incoming>
      <outgoing>SF_S_T_11</outgoing>
    </task>

    <!-- 10. Gateway: Keputusan admin? -->
    <exclusiveGateway id="GW_S_StatusKeputusan" name="Apa keputusan Admin terhadap pesanan ini?">
      <incoming>SF_S_T_11</incoming>
      <outgoing>SF_S_T_12_Konfirmasi</outgoing>
      <outgoing>SF_S_T_12_Tolak</outgoing>
    </exclusiveGateway>

    <!-- 11a. Admin tolak / batalkan: kirim email penolakan ke pelanggan -->
    <task id="Task_S_KirimEmailTolak" name="Mengupdate status pesanan menjadi cancelled di database dan mengirim email otomatis ke pelanggan berisi alasan penolakan dan permintaan maaf">
      <incoming>SF_S_T_12_Tolak</incoming>
      <outgoing>SF_S_TOLAK_END</outgoing>
    </task>

    <endEvent id="End_S_PesananDitolak" name="Pesanan dibatalkan oleh admin, pelanggan diberitahu via email">
      <incoming>SF_S_TOLAK_END</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 11b. Admin konfirmasi pesanan: kirim email status OK ke pelanggan -->
    <task id="Task_S_KirimEmailStatusOK" name="Mengupdate status pesanan menjadi paid_processing di database dan mengirim email otomatis ke pelanggan bahwa pesanan dikonfirmasi dan sedang dipersiapkan">
      <incoming>SF_S_T_12_Konfirmasi</incoming>
      <outgoing>SF_S_T_13</outgoing>
    </task>

    <!-- 12. Proses update status selesai dari admin -->
    <task id="Task_S_UpdateStatusSelesai" name="Menerima aksi Admin yang menandai pesanan sebagai selesai / siap diambil dan mengupdate status menjadi completed di database">
      <incoming>SF_S_T_13</incoming>
      <outgoing>SF_S_T_14</outgoing>
    </task>

    <!-- 13. Kirim email siap diambil ke pelanggan -->
    <task id="Task_S_KirimEmailSiap" name="Mengirim email otomatis ke pelanggan bahwa produk sudah selesai dipersiapkan dan siap diambil atau akan diantarkan sesuai tanggal yang disepakati">
      <incoming>SF_S_T_14</incoming>
      <outgoing>SF_S_END</outgoing>
    </task>

    <!-- END -->
    <endEvent id="End_S_Selesai" name="Sistem telah menyelesaikan seluruh alur notifikasi, status pesanan: completed">
      <incoming>SF_S_END</incoming>
    </endEvent>

    <!-- Sequence Flows: Sistem -->
    <sequenceFlow id="SF_S_T_01"             sourceRef="Start_S"                    targetRef="Task_S_TampilKatalog"/>
    <sequenceFlow id="SF_S_T_02"             sourceRef="Task_S_TampilKatalog"       targetRef="Task_S_FilterProduk"/>
    <sequenceFlow id="SF_S_T_03"             sourceRef="Task_S_FilterProduk"        targetRef="Task_S_ValidasiForm"/>
    <sequenceFlow id="SF_S_T_04"             sourceRef="Task_S_ValidasiForm"        targetRef="GW_S_FormValid"/>
    <sequenceFlow id="SF_S_T_05_Valid"       name="Valid"                           sourceRef="GW_S_FormValid"             targetRef="Task_S_SimpanPesanan"/>
    <sequenceFlow id="SF_S_T_05_Invalid"     name="Tidak valid"                     sourceRef="GW_S_FormValid"             targetRef="End_S_FormDitolak"/>
    <sequenceFlow id="SF_S_T_06"             sourceRef="Task_S_SimpanPesanan"       targetRef="Task_S_TerimaNotifBayar"/>
    <sequenceFlow id="SF_S_T_07"             sourceRef="Task_S_TerimaNotifBayar"    targetRef="Task_S_SimpanBukti"/>
    <sequenceFlow id="SF_S_T_08"             sourceRef="Task_S_SimpanBukti"         targetRef="Task_S_KirimEmailAdmin"/>
    <sequenceFlow id="SF_S_T_09"             sourceRef="Task_S_KirimEmailAdmin"     targetRef="Task_S_KirimEmailPelanggan"/>
    <sequenceFlow id="SF_S_T_10"             sourceRef="Task_S_KirimEmailPelanggan" targetRef="Task_S_ProsesStatusUpdate"/>
    <sequenceFlow id="SF_S_T_11"             sourceRef="Task_S_ProsesStatusUpdate"  targetRef="GW_S_StatusKeputusan"/>
    <sequenceFlow id="SF_S_T_12_Konfirmasi"  name="Admin mengkonfirmasi pesanan"    sourceRef="GW_S_StatusKeputusan"       targetRef="Task_S_KirimEmailStatusOK"/>
    <sequenceFlow id="SF_S_T_12_Tolak"       name="Admin menolak / batalkan pesanan" sourceRef="GW_S_StatusKeputusan"      targetRef="Task_S_KirimEmailTolak"/>
    <sequenceFlow id="SF_S_TOLAK_END"        sourceRef="Task_S_KirimEmailTolak"     targetRef="End_S_PesananDitolak"/>
    <sequenceFlow id="SF_S_T_13"             sourceRef="Task_S_KirimEmailStatusOK"  targetRef="Task_S_UpdateStatusSelesai"/>
    <sequenceFlow id="SF_S_T_14"             sourceRef="Task_S_UpdateStatusSelesai" targetRef="Task_S_KirimEmailSiap"/>
    <sequenceFlow id="SF_S_END"              sourceRef="Task_S_KirimEmailSiap"      targetRef="End_S_Selesai"/>
  </process>

  <!-- ============================================================ -->
  <!--  POOL 3: PROSES ADMIN SADITA (DASHBOARD WEB)                 -->
  <!-- ============================================================ -->
  <process id="Proc_Admin" name="Proses Admin Sadita melalui Dashboard Web" isExecutable="false">

    <laneSet id="LS_Admin">
      <lane id="Lane_Admin" name="Admin Sadita (Dashboard Web)">
        <flowNodeRef>Start_A</flowNodeRef>
        <flowNodeRef>Task_A_TerimaEmailPesanan</flowNodeRef>
        <flowNodeRef>Task_A_LoginDashboard</flowNodeRef>
        <flowNodeRef>Task_A_LihatDaftarPesanan</flowNodeRef>
        <flowNodeRef>Task_A_BukaPesanan</flowNodeRef>
        <flowNodeRef>Task_A_CekBuktiTransfer</flowNodeRef>
        <flowNodeRef>Task_A_CekStokDashboard</flowNodeRef>
        <flowNodeRef>Task_A_CekTanggalKonflik</flowNodeRef>
        <flowNodeRef>GW_A_BisaTerima</flowNodeRef>
        <flowNodeRef>Task_A_UpdateStatusPesanan</flowNodeRef>
        <flowNodeRef>Task_A_TolakPesanan</flowNodeRef>
        <flowNodeRef>Task_A_PersiapkanProduk</flowNodeRef>
        <flowNodeRef>Task_A_UpdateStokDashboard</flowNodeRef>
        <flowNodeRef>Task_A_TandaiSelesai</flowNodeRef>
        <flowNodeRef>End_A_Selesai</flowNodeRef>
        <flowNodeRef>End_A_Ditolak</flowNodeRef>
      </lane>
    </laneSet>

    <!-- START: Admin menerima email notifikasi pesanan baru -->
    <startEvent id="Start_A" name="Admin menerima email notifikasi pesanan baru dari SaditaSystem">
      <outgoing>SF_A_T_01</outgoing>
      <messageEventDefinition messageRef="Msg_NotifAdminPesananBaru"/>
    </startEvent>

    <!-- 1. Baca email notifikasi -->
    <task id="Task_A_TerimaEmailPesanan" name="Membaca email notifikasi dari sistem berisi detail pesanan baru: Order ID, nama pelanggan, produk yang dipesan, dan tanggal acara">
      <incoming>SF_A_T_01</incoming>
      <outgoing>SF_A_T_02</outgoing>
    </task>

    <!-- 2. Login ke dashboard -->
    <task id="Task_A_LoginDashboard" name="Membuka browser dan login ke halaman Admin Dashboard SaditaSystem menggunakan email dan password admin">
      <incoming>SF_A_T_02</incoming>
      <outgoing>SF_A_T_03</outgoing>
    </task>

    <!-- 3. Buka halaman daftar pesanan -->
    <task id="Task_A_LihatDaftarPesanan" name="Mengakses menu Manajemen Pesanan di dashboard dan melihat daftar semua pesanan dengan filter status: pending_payment">
      <incoming>SF_A_T_03</incoming>
      <outgoing>SF_A_T_04</outgoing>
    </task>

    <!-- 4. Buka detail pesanan yang masuk -->
    <task id="Task_A_BukaPesanan" name="Mengklik pesanan baru berdasarkan Order ID untuk melihat detail lengkap: data pelanggan, produk yang dipesan, tanggal acara, total harga, dan bukti transfer">
      <incoming>SF_A_T_04</incoming>
      <outgoing>SF_A_T_05</outgoing>
    </task>

    <!-- 5. Cek bukti transfer -->
    <task id="Task_A_CekBuktiTransfer" name="Melihat foto bukti transfer yang diupload pelanggan dan memverifikasi nominal dengan melakukan pengecekan mutasi rekening bank admin">
      <incoming>SF_A_T_05</incoming>
      <outgoing>SF_A_T_06</outgoing>
    </task>

    <!-- 6. Cek stok di dashboard -->
    <task id="Task_A_CekStokDashboard" name="Mengecek ketersediaan stok produk yang dipesan melalui menu Manajemen Produk di dashboard (data stok real-time dari database)">
      <incoming>SF_A_T_06</incoming>
      <outgoing>SF_A_T_07</outgoing>
    </task>

    <!-- 7. Cek konflik tanggal -->
    <task id="Task_A_CekTanggalKonflik" name="Mengecek kalender pesanan di dashboard untuk memastikan tidak ada pesanan lain pada tanggal acara yang sama (sistem otomatis mendeteksi konflik)">
      <incoming>SF_A_T_07</incoming>
      <outgoing>SF_A_T_08</outgoing>
    </task>

    <!-- 8. Gateway: Bisa terima pesanan? -->
    <exclusiveGateway id="GW_A_BisaTerima" name="Apakah pembayaran valid, stok tersedia, dan tanggal tidak konflik?">
      <incoming>SF_A_T_08</incoming>
      <outgoing>SF_A_T_09_Ya</outgoing>
      <outgoing>SF_A_T_09_Tidak</outgoing>
    </exclusiveGateway>

    <!-- 9a. Tidak bisa: tolak pesanan via dashboard -->
    <task id="Task_A_TolakPesanan" name="Mengklik tombol Tolak Pesanan di dashboard, mengisi alasan penolakan (bayar tidak sesuai / stok habis / jadwal konflik), lalu klik Konfirmasi">
      <incoming>SF_A_T_09_Tidak</incoming>
      <outgoing>SF_A_TOLAK_END</outgoing>
    </task>

    <endEvent id="End_A_Ditolak" name="Pesanan ditolak, sistem otomatis mengirim email alasan penolakan ke pelanggan">
      <incoming>SF_A_TOLAK_END</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 9b. Bisa terima: tekan tombol Konfirmasi Pesanan di dashboard -->
    <task id="Task_A_UpdateStatusPesanan" name="Mengklik tombol Konfirmasi Pesanan di dashboard, status pesanan berubah menjadi paid_processing dan sistem otomatis mengirim email ke pelanggan">
      <incoming>SF_A_T_09_Ya</incoming>
      <outgoing>SF_A_T_10</outgoing>
    </task>

    <!-- 10. Persiapkan produk secara fisik -->
    <task id="Task_A_PersiapkanProduk" name="Mempersiapkan dan merakit produk dekorasi / seserahan secara fisik sesuai spesifikasi pesanan (jenis, ukuran, material, desain) sebelum hari H">
      <incoming>SF_A_T_10</incoming>
      <outgoing>SF_A_T_11</outgoing>
    </task>

    <!-- 11. Update stok di dashboard -->
    <task id="Task_A_UpdateStokDashboard" name="Mengupdate jumlah stok produk di dashboard setelah produk selesai dipreparasi (mengurangi stok sesuai jumlah yang dipesan)">
      <incoming>SF_A_T_11</incoming>
      <outgoing>SF_A_T_12</outgoing>
    </task>

    <!-- 12. Tandai pesanan selesai / siap diambil -->
    <task id="Task_A_TandaiSelesai" name="Mengklik tombol Tandai Selesai / Siap Diambil di dashboard setelah produk siap, status pesanan berubah menjadi completed dan sistem otomatis mengirim email siap diambil ke pelanggan">
      <incoming>SF_A_T_12</incoming>
      <outgoing>SF_A_END</outgoing>
    </task>

    <!-- END -->
    <endEvent id="End_A_Selesai" name="Admin selesai memproses pesanan, produk siap diserahkan kepada pelanggan pada hari H">
      <incoming>SF_A_END</incoming>
    </endEvent>

    <!-- Sequence Flows: Admin -->
    <sequenceFlow id="SF_A_T_01"      sourceRef="Start_A"                      targetRef="Task_A_TerimaEmailPesanan"/>
    <sequenceFlow id="SF_A_T_02"      sourceRef="Task_A_TerimaEmailPesanan"    targetRef="Task_A_LoginDashboard"/>
    <sequenceFlow id="SF_A_T_03"      sourceRef="Task_A_LoginDashboard"        targetRef="Task_A_LihatDaftarPesanan"/>
    <sequenceFlow id="SF_A_T_04"      sourceRef="Task_A_LihatDaftarPesanan"    targetRef="Task_A_BukaPesanan"/>
    <sequenceFlow id="SF_A_T_05"      sourceRef="Task_A_BukaPesanan"           targetRef="Task_A_CekBuktiTransfer"/>
    <sequenceFlow id="SF_A_T_06"      sourceRef="Task_A_CekBuktiTransfer"      targetRef="Task_A_CekStokDashboard"/>
    <sequenceFlow id="SF_A_T_07"      sourceRef="Task_A_CekStokDashboard"      targetRef="Task_A_CekTanggalKonflik"/>
    <sequenceFlow id="SF_A_T_08"      sourceRef="Task_A_CekTanggalKonflik"     targetRef="GW_A_BisaTerima"/>
    <sequenceFlow id="SF_A_T_09_Ya"   name="Semua kondisi terpenuhi"           sourceRef="GW_A_BisaTerima"            targetRef="Task_A_UpdateStatusPesanan"/>
    <sequenceFlow id="SF_A_T_09_Tidak" name="Ada kondisi yang tidak terpenuhi" sourceRef="GW_A_BisaTerima"            targetRef="Task_A_TolakPesanan"/>
    <sequenceFlow id="SF_A_TOLAK_END" sourceRef="Task_A_TolakPesanan"          targetRef="End_A_Ditolak"/>
    <sequenceFlow id="SF_A_T_10"      sourceRef="Task_A_UpdateStatusPesanan"   targetRef="Task_A_PersiapkanProduk"/>
    <sequenceFlow id="SF_A_T_11"      sourceRef="Task_A_PersiapkanProduk"      targetRef="Task_A_UpdateStokDashboard"/>
    <sequenceFlow id="SF_A_T_12"      sourceRef="Task_A_UpdateStokDashboard"   targetRef="Task_A_TandaiSelesai"/>
    <sequenceFlow id="SF_A_END"       sourceRef="Task_A_TandaiSelesai"         targetRef="End_A_Selesai"/>
  </process>

  <!-- ============================================================ -->
  <!--  MESSAGES                                                    -->
  <!-- ============================================================ -->
  <message id="Msg_RequestKatalog"          name="HTTP Request Halaman Katalog dari Browser"/>
  <message id="Msg_SubmitCheckout"          name="Form Checkout Disubmit (POST Request)"/>
  <message id="Msg_UploadBuktiTransfer"     name="Upload File Bukti Transfer"/>
  <message id="Msg_EmailKonfirmasiPelanggan" name="Email Otomatis: Konfirmasi Pesanan Masuk (dengan Order ID)"/>
  <message id="Msg_EmailNotifAdmin"         name="Email Otomatis: Notifikasi Pesanan Baru ke Admin Sadita"/>
  <message id="Msg_EmailStatusOK"           name="Email Otomatis: Pesanan Dikonfirmasi Admin"/>
  <message id="Msg_EmailSiapDiambil"        name="Email Otomatis: Produk Siap Diambil pada Tanggal H"/>
  <message id="Msg_NotifAdminPesananBaru"   name="Email Notifikasi Pesanan Baru ke Admin"/>
  <message id="Msg_AksiAdminKonfirmasi"     name="Action: Admin Klik Konfirmasi Pesanan di Dashboard"/>
  <message id="Msg_AksiAdminSelesai"        name="Action: Admin Tandai Pesanan Selesai di Dashboard"/>

</definitions>
