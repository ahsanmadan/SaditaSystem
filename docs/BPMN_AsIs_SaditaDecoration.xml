<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_AsIs"
  name="BPMN As-Is - Proses Pemesanan Manual Sadita Decoration"
  targetNamespace="http://saditasystem.com/bpmn/asis"
  exporter="Enterprise Architect"
  exporterVersion="16.0">

  <!--
    ================================================================
    BPMN AS-IS: Proses Pemesanan Manual Sadita Decoration
    Kondisi SEBELUM implementasi SaditaSystem
    Aktor:
      1. Pelanggan
      2. Admin / Pemilik Sadita Decoration
    Catatan Kritis:
      - TIDAK ADA sistem DP. Pembayaran penuh (Lunas) dilakukan saat
        pelanggan mengambil / pada hari H layanan.
      - Komunikasi seluruhnya melalui WhatsApp secara manual.
      - Pencatatan pesanan dilakukan di buku fisik / catatan manual.
    ================================================================
  -->

  <!-- ============================================================ -->
  <!--  COLLABORATION                                               -->
  <!-- ============================================================ -->
  <collaboration id="Collaboration_AsIs" name="Proses Pemesanan Manual via WhatsApp - Sadita Decoration">
    <participant id="Participant_Pelanggan"      name="Pelanggan"                      processRef="Process_Pelanggan"/>
    <participant id="Participant_AdminSadita"    name="Admin / Pemilik Sadita Decoration" processRef="Process_AdminSadita"/>

    <!-- Message Flows antar Pool -->
    <messageFlow id="MF_001" name="Kirim pesan tanya produk via WA"          sourceRef="Task_PelangganKirimPesan"       targetRef="Task_AdminTerimaInkuiri"/>
    <messageFlow id="MF_002" name="Balasan info katalog, material, ukuran, harga" sourceRef="Task_AdminBalasPesan"      targetRef="Task_PelangganTerimaInfo"/>
    <messageFlow id="MF_003" name="Pesan konfirmasi detail pesanan"           sourceRef="Task_PelangganKonfirmasiOrder"  targetRef="Task_AdminTerimaDetail"/>
    <messageFlow id="MF_004" name="Notifikasi total harga &amp; info pembayaran H" sourceRef="Task_AdminKirimTotalHarga" targetRef="Task_PelangganTerimaHarga"/>
    <messageFlow id="MF_005" name="Bukti pembayaran lunas (transfer/tunai)"  sourceRef="Task_PelangganBayarLunas"       targetRef="Task_AdminVerifikasiBayar"/>
    <messageFlow id="MF_006" name="Konfirmasi pesanan diterima &amp; terkunci" sourceRef="Task_AdminKonfirmasiPesanan"  targetRef="Task_PelangganTerimaKonfirmasi"/>
  </collaboration>

  <!-- ============================================================ -->
  <!--  PROCESS: PELANGGAN                                          -->
  <!-- ============================================================ -->
  <process id="Process_Pelanggan" name="Proses Pelanggan" isExecutable="false">

    <laneSet id="LaneSet_Pelanggan">
      <lane id="Lane_Pelanggan" name="Pelanggan">
        <flowNodeRef>Start_Pelanggan</flowNodeRef>
        <flowNodeRef>Task_PelangganCariInfo</flowNodeRef>
        <flowNodeRef>Task_PelangganKirimPesan</flowNodeRef>
        <flowNodeRef>Task_PelangganTerimaInfo</flowNodeRef>
        <flowNodeRef>GW_PelangganMinat</flowNodeRef>
        <flowNodeRef>Task_PelangganKonfirmasiOrder</flowNodeRef>
        <flowNodeRef>Task_PelangganTerimaHarga</flowNodeRef>
        <flowNodeRef>GW_PelangganSetujuHarga</flowNodeRef>
        <flowNodeRef>Task_PelangganBayarLunas</flowNodeRef>
        <flowNodeRef>Task_PelangganTerimaKonfirmasi</flowNodeRef>
        <flowNodeRef>Task_PelangganTungguHariH</flowNodeRef>
        <flowNodeRef>Task_PelangganAmbilLayanan</flowNodeRef>
        <flowNodeRef>End_Pelanggan_Selesai</flowNodeRef>
        <flowNodeRef>End_Pelanggan_TidakMinat</flowNodeRef>
        <flowNodeRef>End_Pelanggan_BatalHarga</flowNodeRef>
      </lane>
    </laneSet>

    <!-- 1. Pelanggan butuh dekorasi / seserahan -->
    <startEvent id="Start_Pelanggan" name="Pelanggan membutuhkan jasa dekorasi atau seserahan">
      <outgoing>SF_P_01</outgoing>
    </startEvent>

    <!-- 2. Cari info produk secara manual (Instagram / kenalan / dari mulut ke mulut) -->
    <task id="Task_PelangganCariInfo" name="Mencari informasi produk Sadita melalui Instagram atau rekomendasi kenalan">
      <incoming>SF_P_01</incoming>
      <outgoing>SF_P_02</outgoing>
    </task>

    <!-- 3. Kirim pesan ke WA Admin Sadita -->
    <task id="Task_PelangganKirimPesan" name="Mengirim pesan ke admin Sadita via WhatsApp (menanyakan katalog, harga, dan ketersediaan)">
      <incoming>SF_P_02</incoming>
      <outgoing>SF_P_03</outgoing>
    </task>

    <!-- 4. Terima balasan info dari admin (menunggu admin online) -->
    <task id="Task_PelangganTerimaInfo" name="Menerima balasan admin berisi info produk (jenis papan, ukuran, material, harga estimasi)">
      <incoming>SF_P_03</incoming>
      <outgoing>SF_P_04</outgoing>
    </task>

    <!-- 5. Gateway: Apakah pelanggan tertarik? -->
    <exclusiveGateway id="GW_PelangganMinat" name="Apakah pelanggan tertarik dengan produk Sadita?">
      <incoming>SF_P_04</incoming>
      <outgoing>SF_P_05_Ya</outgoing>
      <outgoing>SF_P_05_Tidak</outgoing>
    </exclusiveGateway>

    <!-- 6a. Jika Tidak tertarik: selesai -->
    <endEvent id="End_Pelanggan_TidakMinat" name="Pelanggan tidak jadi memesan (tidak tertarik)">
      <incoming>SF_P_05_Tidak</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 6b. Jika Tertarik: konfirmasi detail pesanan ke admin -->
    <task id="Task_PelangganKonfirmasiOrder" name="Mengirim detail pesanan ke admin via WA: nama, tanggal acara, jenis produk, ukuran, material, dan jumlah">
      <incoming>SF_P_05_Ya</incoming>
      <outgoing>SF_P_06</outgoing>
    </task>

    <!-- 7. Terima total harga final dari admin -->
    <task id="Task_PelangganTerimaHarga" name="Menerima pesan dari admin berisi total harga final dan instruksi pembayaran">
      <incoming>SF_P_06</incoming>
      <outgoing>SF_P_07</outgoing>
    </task>

    <!-- 8. Gateway: Setuju harga? -->
    <exclusiveGateway id="GW_PelangganSetujuHarga" name="Apakah pelanggan setuju dengan total harga?">
      <incoming>SF_P_07</incoming>
      <outgoing>SF_P_08_Setuju</outgoing>
      <outgoing>SF_P_08_TidakSetuju</outgoing>
    </exclusiveGateway>

    <!-- 9a. Tidak setuju harga: batal -->
    <endEvent id="End_Pelanggan_BatalHarga" name="Pelanggan membatalkan pesanan karena tidak setuju harga">
      <incoming>SF_P_08_TidakSetuju</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 9b. Setuju: Bayar lunas (FULL PAYMENT - tidak ada DP) -->
    <task id="Task_PelangganBayarLunas" name="Melakukan pembayaran LUNAS penuh via transfer bank atau tunai langsung ke Sadita">
      <incoming>SF_P_08_Setuju</incoming>
      <outgoing>SF_P_09</outgoing>
    </task>

    <!-- 10. Terima konfirmasi pesanan diterima -->
    <task id="Task_PelangganTerimaKonfirmasi" name="Menerima konfirmasi dari admin bahwa pembayaran diterima dan pesanan terkunci">
      <incoming>SF_P_09</incoming>
      <outgoing>SF_P_10</outgoing>
    </task>

    <!-- 11. Menunggu hari H tanpa tracking status apapun -->
    <task id="Task_PelangganTungguHariH" name="Menunggu hingga hari H tanpa ada fitur tracking status pesanan (tidak dapat memantau progress)">
      <incoming>SF_P_10</incoming>
      <outgoing>SF_P_11</outgoing>
    </task>

    <!-- 12. Mengambil atau menerima layanan pada hari H -->
    <task id="Task_PelangganAmbilLayanan" name="Mengambil atau menerima layanan dekorasi / seserahan dari Sadita pada hari H yang telah disepakati">
      <incoming>SF_P_11</incoming>
      <outgoing>SF_P_12</outgoing>
    </task>

    <!-- 13. Selesai -->
    <endEvent id="End_Pelanggan_Selesai" name="Layanan diterima, transaksi selesai">
      <incoming>SF_P_12</incoming>
    </endEvent>

    <!-- Sequence Flows: Pelanggan -->
    <sequenceFlow id="SF_P_01"          sourceRef="Start_Pelanggan"              targetRef="Task_PelangganCariInfo"/>
    <sequenceFlow id="SF_P_02"          sourceRef="Task_PelangganCariInfo"       targetRef="Task_PelangganKirimPesan"/>
    <sequenceFlow id="SF_P_03"          sourceRef="Task_PelangganKirimPesan"     targetRef="Task_PelangganTerimaInfo"/>
    <sequenceFlow id="SF_P_04"          sourceRef="Task_PelangganTerimaInfo"     targetRef="GW_PelangganMinat"/>
    <sequenceFlow id="SF_P_05_Ya"       name="Ya, tertarik"                       sourceRef="GW_PelangganMinat"            targetRef="Task_PelangganKonfirmasiOrder"/>
    <sequenceFlow id="SF_P_05_Tidak"    name="Tidak tertarik"                     sourceRef="GW_PelangganMinat"            targetRef="End_Pelanggan_TidakMinat"/>
    <sequenceFlow id="SF_P_06"          sourceRef="Task_PelangganKonfirmasiOrder" targetRef="Task_PelangganTerimaHarga"/>
    <sequenceFlow id="SF_P_07"          sourceRef="Task_PelangganTerimaHarga"    targetRef="GW_PelangganSetujuHarga"/>
    <sequenceFlow id="SF_P_08_Setuju"   name="Setuju, lanjut bayar"              sourceRef="GW_PelangganSetujuHarga"      targetRef="Task_PelangganBayarLunas"/>
    <sequenceFlow id="SF_P_08_TidakSetuju" name="Tidak setuju, batalkan"         sourceRef="GW_PelangganSetujuHarga"      targetRef="End_Pelanggan_BatalHarga"/>
    <sequenceFlow id="SF_P_09"          sourceRef="Task_PelangganBayarLunas"     targetRef="Task_PelangganTerimaKonfirmasi"/>
    <sequenceFlow id="SF_P_10"          sourceRef="Task_PelangganTerimaKonfirmasi" targetRef="Task_PelangganTungguHariH"/>
    <sequenceFlow id="SF_P_11"          sourceRef="Task_PelangganTungguHariH"    targetRef="Task_PelangganAmbilLayanan"/>
    <sequenceFlow id="SF_P_12"          sourceRef="Task_PelangganAmbilLayanan"   targetRef="End_Pelanggan_Selesai"/>
  </process>

  <!-- ============================================================ -->
  <!--  PROCESS: ADMIN / PEMILIK SADITA                             -->
  <!-- ============================================================ -->
  <process id="Process_AdminSadita" name="Proses Admin / Pemilik Sadita Decoration" isExecutable="false">

    <laneSet id="LaneSet_Admin">
      <lane id="Lane_Admin" name="Admin / Pemilik Sadita Decoration">
        <flowNodeRef>Start_Admin</flowNodeRef>
        <flowNodeRef>Task_AdminTerimaInkuiri</flowNodeRef>
        <flowNodeRef>Task_AdminCekStokManual</flowNodeRef>
        <flowNodeRef>Task_AdminCekJadwalManual</flowNodeRef>
        <flowNodeRef>GW_AdminKetersediaan</flowNodeRef>
        <flowNodeRef>Task_AdminBalasPesan</flowNodeRef>
        <flowNodeRef>Task_AdminInfoTidakTersedia</flowNodeRef>
        <flowNodeRef>Task_AdminTerimaDetail</flowNodeRef>
        <flowNodeRef>Task_AdminHitungHarga</flowNodeRef>
        <flowNodeRef>Task_AdminKirimTotalHarga</flowNodeRef>
        <flowNodeRef>Task_AdminVerifikasiBayar</flowNodeRef>
        <flowNodeRef>GW_AdminBayarValid</flowNodeRef>
        <flowNodeRef>Task_AdminMintaUlangBayar</flowNodeRef>
        <flowNodeRef>Task_AdminKonfirmasiPesanan</flowNodeRef>
        <flowNodeRef>Task_AdminCatatPesananManual</flowNodeRef>
        <flowNodeRef>Task_AdminPersiapkanProduk</flowNodeRef>
        <flowNodeRef>Task_AdminLayaniHariH</flowNodeRef>
        <flowNodeRef>End_Admin_Selesai</flowNodeRef>
        <flowNodeRef>End_Admin_Ditolak</flowNodeRef>
        <flowNodeRef>End_Admin_BayarGagal</flowNodeRef>
      </lane>
    </laneSet>

    <!-- 1. Admin menerima notifikasi WA masuk -->
    <startEvent id="Start_Admin" name="Menerima pesan WhatsApp dari pelanggan yang ingin bertanya tentang produk">
      <outgoing>SF_A_01</outgoing>
      <messageEventDefinition messageRef="Msg_InkuiriPelanggan"/>
    </startEvent>

    <!-- 2. Baca dan pahami pertanyaan pelanggan -->
    <task id="Task_AdminTerimaInkuiri" name="Membaca dan memahami permintaan pelanggan: jenis produk, tanggal acara, detail kebutuhan">
      <incoming>SF_A_01</incoming>
      <outgoing>SF_A_02</outgoing>
    </task>

    <!-- 3. Cek stok fisik secara manual -->
    <task id="Task_AdminCekStokManual" name="Mengecek stok perlengkapan fisik secara manual (papan, box, kain, aksesori) di gudang">
      <incoming>SF_A_02</incoming>
      <outgoing>SF_A_03</outgoing>
    </task>

    <!-- 4. Cek jadwal di buku catatan fisik -->
    <task id="Task_AdminCekJadwalManual" name="Mengecek buku catatan jadwal pesanan untuk memastikan tanggal yang diminta pelanggan masih kosong">
      <incoming>SF_A_03</incoming>
      <outgoing>SF_A_04</outgoing>
    </task>

    <!-- 5. Gateway: Stok dan jadwal tersedia? -->
    <exclusiveGateway id="GW_AdminKetersediaan" name="Apakah stok produk tersedia AND tanggal pesanan masih kosong?">
      <incoming>SF_A_04</incoming>
      <outgoing>SF_A_05_Tersedia</outgoing>
      <outgoing>SF_A_05_TidakTersedia</outgoing>
    </exclusiveGateway>

    <!-- 6a. Tidak tersedia: informasikan ke pelanggan dan tutup proses -->
    <task id="Task_AdminInfoTidakTersedia" name="Membalas WA pelanggan dengan informasi bahwa stok habis atau jadwal sudah penuh dan menyampaikan permintaan maaf">
      <incoming>SF_A_05_TidakTersedia</incoming>
      <outgoing>SF_A_TOLAK</outgoing>
    </task>

    <endEvent id="End_Admin_Ditolak" name="Pesanan tidak dapat diproses (stok atau jadwal tidak tersedia)">
      <incoming>SF_A_TOLAK</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 6b. Tersedia: Balas WA dengan info produk lengkap -->
    <task id="Task_AdminBalasPesan" name="Membalas WA pelanggan dengan informasi lengkap: jenis produk tersedia, variasi ukuran, material (kaca/akrilik), estimasi harga, dan jadwal tersedia">
      <incoming>SF_A_05_Tersedia</incoming>
      <outgoing>SF_A_06</outgoing>
    </task>

    <!-- 7. Terima detail pesanan dari pelanggan -->
    <task id="Task_AdminTerimaDetail" name="Menerima pesan konfirmasi detail pesanan dari pelanggan (nama, tanggal acara, jenis, ukuran, jumlah)">
      <incoming>SF_A_06</incoming>
      <outgoing>SF_A_07</outgoing>
    </task>

    <!-- 8. Hitung total harga -->
    <task id="Task_AdminHitungHarga" name="Menghitung total biaya secara manual berdasarkan jenis produk, ukuran, material, dan jumlah yang dipesan">
      <incoming>SF_A_07</incoming>
      <outgoing>SF_A_08</outgoing>
    </task>

    <!-- 9. Kirim total harga ke pelanggan -->
    <task id="Task_AdminKirimTotalHarga" name="Mengirim pesan WA berisi total harga final dan instruksi pembayaran LUNAS (Full Payment - tidak ada sistem DP)">
      <incoming>SF_A_08</incoming>
      <outgoing>SF_A_09</outgoing>
    </task>

    <!-- 10. Verifikasi pembayaran dari pelanggan -->
    <task id="Task_AdminVerifikasiBayar" name="Menerima bukti transfer dari pelanggan dan memverifikasi secara manual melalui pengecekan mutasi rekening bank">
      <incoming>SF_A_09</incoming>
      <outgoing>SF_A_10</outgoing>
    </task>

    <!-- 11. Gateway: Pembayaran valid? -->
    <exclusiveGateway id="GW_AdminBayarValid" name="Apakah pembayaran lunas sudah diterima dan sesuai nominal?">
      <incoming>SF_A_10</incoming>
      <outgoing>SF_A_11_Valid</outgoing>
      <outgoing>SF_A_11_TidakValid</outgoing>
    </exclusiveGateway>

    <!-- 12a. Tidak valid: minta bayar ulang -->
    <task id="Task_AdminMintaUlangBayar" name="Memberitahu pelanggan via WA bahwa pembayaran tidak sesuai / belum masuk dan meminta konfirmasi ulang atau pembayaran ulang">
      <incoming>SF_A_11_TidakValid</incoming>
      <outgoing>SF_A_BAYAR_GAGAL</outgoing>
    </task>

    <endEvent id="End_Admin_BayarGagal" name="Proses pembayaran gagal, admin menunggu respons pelanggan (loop manual)">
      <incoming>SF_A_BAYAR_GAGAL</incoming>
      <terminateEventDefinition/>
    </endEvent>

    <!-- 12b. Valid: konfirmasi pesanan ke pelanggan -->
    <task id="Task_AdminKonfirmasiPesanan" name="Mengirim WA konfirmasi kepada pelanggan: pembayaran diterima, pesanan telah terkunci untuk tanggal yang disepakati">
      <incoming>SF_A_11_Valid</incoming>
      <outgoing>SF_A_12</outgoing>
    </task>

    <!-- 13. Catat pesanan di buku manual -->
    <task id="Task_AdminCatatPesananManual" name="Mencatat detail pesanan (nama pelanggan, tanggal, produk, total bayar) di buku catatan fisik / spreadsheet manual">
      <incoming>SF_A_12</incoming>
      <outgoing>SF_A_13</outgoing>
    </task>

    <!-- 14. Persiapkan produk/dekorasi -->
    <task id="Task_AdminPersiapkanProduk" name="Mempersiapkan dan merakit produk dekorasi / seserahan sesuai pesanan pelanggan sebelum hari H">
      <incoming>SF_A_13</incoming>
      <outgoing>SF_A_14</outgoing>
    </task>

    <!-- 15. Layani pelanggan pada hari H -->
    <task id="Task_AdminLayaniHariH" name="Menyerahkan produk / melaksanakan layanan dekorasi kepada pelanggan pada tanggal yang telah disepakati (hari H)">
      <incoming>SF_A_14</incoming>
      <outgoing>SF_A_END</outgoing>
    </task>

    <!-- 16. Selesai -->
    <endEvent id="End_Admin_Selesai" name="Layanan berhasil diberikan kepada pelanggan, transaksi selesai">
      <incoming>SF_A_END</incoming>
    </endEvent>

    <!-- Sequence Flows: Admin -->
    <sequenceFlow id="SF_A_01"              sourceRef="Start_Admin"                   targetRef="Task_AdminTerimaInkuiri"/>
    <sequenceFlow id="SF_A_02"              sourceRef="Task_AdminTerimaInkuiri"        targetRef="Task_AdminCekStokManual"/>
    <sequenceFlow id="SF_A_03"              sourceRef="Task_AdminCekStokManual"        targetRef="Task_AdminCekJadwalManual"/>
    <sequenceFlow id="SF_A_04"              sourceRef="Task_AdminCekJadwalManual"      targetRef="GW_AdminKetersediaan"/>
    <sequenceFlow id="SF_A_05_Tersedia"     name="Tersedia"                            sourceRef="GW_AdminKetersediaan"          targetRef="Task_AdminBalasPesan"/>
    <sequenceFlow id="SF_A_05_TidakTersedia" name="Stok habis atau jadwal penuh"       sourceRef="GW_AdminKetersediaan"          targetRef="Task_AdminInfoTidakTersedia"/>
    <sequenceFlow id="SF_A_TOLAK"           sourceRef="Task_AdminInfoTidakTersedia"    targetRef="End_Admin_Ditolak"/>
    <sequenceFlow id="SF_A_06"              sourceRef="Task_AdminBalasPesan"           targetRef="Task_AdminTerimaDetail"/>
    <sequenceFlow id="SF_A_07"              sourceRef="Task_AdminTerimaDetail"         targetRef="Task_AdminHitungHarga"/>
    <sequenceFlow id="SF_A_08"              sourceRef="Task_AdminHitungHarga"          targetRef="Task_AdminKirimTotalHarga"/>
    <sequenceFlow id="SF_A_09"              sourceRef="Task_AdminKirimTotalHarga"      targetRef="Task_AdminVerifikasiBayar"/>
    <sequenceFlow id="SF_A_10"              sourceRef="Task_AdminVerifikasiBayar"      targetRef="GW_AdminBayarValid"/>
    <sequenceFlow id="SF_A_11_Valid"        name="Valid, nominal sesuai"               sourceRef="GW_AdminBayarValid"            targetRef="Task_AdminKonfirmasiPesanan"/>
    <sequenceFlow id="SF_A_11_TidakValid"   name="Tidak valid / belum masuk"           sourceRef="GW_AdminBayarValid"            targetRef="Task_AdminMintaUlangBayar"/>
    <sequenceFlow id="SF_A_BAYAR_GAGAL"    sourceRef="Task_AdminMintaUlangBayar"      targetRef="End_Admin_BayarGagal"/>
    <sequenceFlow id="SF_A_12"              sourceRef="Task_AdminKonfirmasiPesanan"    targetRef="Task_AdminCatatPesananManual"/>
    <sequenceFlow id="SF_A_13"              sourceRef="Task_AdminCatatPesananManual"   targetRef="Task_AdminPersiapkanProduk"/>
    <sequenceFlow id="SF_A_14"              sourceRef="Task_AdminPersiapkanProduk"     targetRef="Task_AdminLayaniHariH"/>
    <sequenceFlow id="SF_A_END"             sourceRef="Task_AdminLayaniHariH"          targetRef="End_Admin_Selesai"/>
  </process>

  <!-- ============================================================ -->
  <!--  MESSAGES                                                    -->
  <!-- ============================================================ -->
  <message id="Msg_InkuiriPelanggan"       name="Pesan WhatsApp dari Pelanggan (Inkuiri Produk)"/>
  <message id="Msg_InfoProduk"             name="Balasan Admin - Informasi Produk dan Harga"/>
  <message id="Msg_DetailPesanan"          name="Konfirmasi Detail Pesanan dari Pelanggan"/>
  <message id="Msg_TotalHarga"             name="Notifikasi Total Harga Final dan Instruksi Pembayaran"/>
  <message id="Msg_BuktiBayar"             name="Bukti Transfer Pembayaran Lunas dari Pelanggan"/>
  <message id="Msg_KonfirmasiPesanan"      name="Konfirmasi Pesanan Terkunci dari Admin"/>

</definitions>
